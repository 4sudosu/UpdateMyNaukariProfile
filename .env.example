# .env holds ONLY the panel password + port (+ optional cloud backup).
# Everything else (interval, WhatsApp) is managed in the dashboard Settings.
PORT=3000
WEB_PASSWORD=change-me-to-something-strong
# Free Upstash Redis backup so Render wipes can't eat your data (optional).
# Get them free at https://upstash.com (Redis → REST API):
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxx...
